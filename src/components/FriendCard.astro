---
const { name, url, avatar, desc } = Astro.props;
import { Image } from "astro:assets";
---

<a
    class="bg-surface-container-lowest hover:bg-surface-container-lowest-hover shadow-md p-4 mx-auto rounded-2xl flex transition-colors w-full"
    href={url}
>
    <Image
        class="w-24 h-24 rounded-full"
        width="192"
        height="192"
        src={avatar}
        alt="avatar"
    />
    <div class="ml-4">
        <div class="text-xl font-semibold">{name}</div>
        <div class="text-sm">{desc}</div>
    </div>
</a>
