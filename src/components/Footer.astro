---
import { SITE } from "../consts";

const today = new Date();
const { slug } = Astro.props;
---

<footer id="footer" class="flex my-8 flex-col items-center">
  <div class="gap-2 flex justify-center items-center text-on-surface-bright">
    Copyright &copy; 2023 - {today.getFullYear()}
    <span>{SITE.author}</span>|
    <a href="/atom.xml">RSS</a>
  </div>
</footer>
