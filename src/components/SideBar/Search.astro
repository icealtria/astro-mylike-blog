---
import { SITE } from "@/consts";
import { Icon } from "astro-icon/components";
---

<div
    class="bg-white rounded-3xl shadow-md focus-within:bg-white transition-colors"
>
    <form
        class="ddg flex p-1 items-center"
        name="x"
        action="https://duckduckgo.com/"
        target="_blank"
    >
        <input type="hidden" value={SITE.domain} name="sites" />
        <input
            type="search"
            class="px-3 py-2 text-black rounded-3xl w-full outline-none"
            placeholder="DuckDuckGo"
            name="q"
        />
        <button
            class="search-button m-1 w-8 text-inverse-surface"
            type="submit"
            aria-label="Search"
        >
            <Icon class="w-6 h-6" name="ic:baseline-search" />
        </button>
    </form>
</div>
