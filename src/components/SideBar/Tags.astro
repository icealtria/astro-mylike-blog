---
import { getTagsInfo } from "@/utils/tags";
const tags = Array.from(getTagsInfo()).sort((a, b) => b[1] - a[1]);
---

<div class="tags flex flex-wrap">
    {
        tags.map(([tag, count]) => (
            <>
                <a class="rounded-full py-1 px-2 tag" href={`/tags/${tag}`}>
                    {tag}
                </a>
                <span class="hidden">{count}</span>
            </>
        ))
    }
</div>

<style>
    .tag {
        @apply hover:bg-primary hover:text-on-primary transition-colors;
    }
</style>
