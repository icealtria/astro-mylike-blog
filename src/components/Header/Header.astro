---
import NavBar from "./NavBar.astro";
import { SITE } from "@/consts";
---

<header
    class="flex justify-center max-w-6xl md:justify-between mx-auto sticky top-0 md:top-2 z-50 mb-8 md:rounded-full"
    style={`view-transition-name: navbar;`}
>
    <div class="blog-title">
        <a href="/">{SITE.title}</a>
    </div>
    <NavBar />
</header>

<style>
    .blog-title {
        animation: shrink-title linear both;
        animation-timeline: scroll();
        animation-range: 0 150px;
        @apply hidden md:flex items-center px-4;
    }

    @keyframes shrink-title {
        from {
            @apply text-2xl;
        }
        to {
            @apply text-base;
        }
    }

    @keyframes shrink-header {
        to {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow:
                0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            max-width: 48rem;
        }
    }

    header {
        animation: shrink-header linear both;
        animation-timeline: scroll();
        animation-range: 0 150px;
    }
</style>
