---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> & { icon?: string };

const { href, icon, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");
---

<a
  href={href}
  class:list={[{ active: isActive }, "header-link flex items-center"]}
  {...props}
  data-astro-prefetch
>
  {icon && <Icon name={icon} is:inline />}
  <slot />
</a>

<style>
  .header-link {
    @apply m-0 rounded-full transition-colors text-on-surface;
  }

  /* .header-link svg {
    @apply sm:inline-block hidden;
  } */

  .active {
    @apply text-on-secondary-container;
  }
</style>
