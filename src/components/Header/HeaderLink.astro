---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> & { icon?: string };

const { href, icon, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");
---

<a
  href={href}
  class:list={[{ active: isActive }, "header-link flex items-center"]}
  {...props}
  data-astro-prefetch
>
  <slot />
</a>

<style>
  .header-link {
    @apply m-0 text-on-surface font-bold px-4 py-2 hover:text-primary;
    position: relative;
  }

  .active {
    color: var(--primary);
  }

  .active::after {
    content: "";
    position: absolute;
    bottom: 0px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 4px);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--primary) 20%,
      var(--primary) 40%,
      transparent 100%
    );
  }
</style>
