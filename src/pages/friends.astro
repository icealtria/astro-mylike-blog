---
import BaseLayout from "@/layouts/Layout.astro";
import FriendCard from "@components/FriendCard.astro";
import Akarin from "@/images/Akarin.png";
---

<BaseLayout title="友情链接" slug="friends">
    <div class="mx-auto max-w-7xl grid grid-cols-fill gap-4 mt-12">
        <FriendCard
            name="Akarin"
            avatar={Akarin}
            url="https://forms.gle/NbggsKMK6a5SKmjR6"
            desc="空空如也，谁来当第一个小可爱.."
        /><FriendCard
            name="Akarin"
            avatar={Akarin}
            url="https://forms.gle/NbggsKMK6a5SKmjR6"
            desc="空空如也，谁来当第一个小可爱.."
        /><FriendCard
            name="Akarin"
            avatar={Akarin}
            url="https://forms.gle/NbggsKMK6a5SKmjR6"
            desc="空空如也，谁来当第一个小可爱.."
        />
    </div>
</BaseLayout>

<style>
    .grid-cols-fill {
        grid-template-columns: repeat(auto-fit, minmax(32ch, 1fr));
    }
</style>
